{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "FixtureRig: demo test_02",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/fixturerig/main.py",
            "args": [
                "--config",
                "config/env.yaml",
                "--config",
                "config/test.yaml"
            ],
            "cwd": "${workspaceFolder}/demo/test_02",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            },
            "console": "integratedTerminal"
        },
        {
            // Debug (F5) stops where the exception of test 2 is raised: --interactive
            // lets it fall through uncaught, and "Uncaught Exceptions" is on by default
            // in the Breakpoints view. Run without debugging (Ctrl+F5) just prints
            // the traceback.
            "name": "FixtureRig: integration testset_02 (--interactive)",
            "type": "debugpy",
            "request": "launch",
            "module": "fixturerig",
            "args": [
                "--config",
                "config/env.yaml",
                "--config",
                "config/test.yaml",
                "--interactive"
            ],
            "cwd": "${workspaceFolder}/devtests/integration/testset_02",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            },
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "FixtureRig: integration tests",
            "type": "node-terminal",
            "request": "launch",
            "command": "${workspaceFolder}/devtests/integration/run_integration_tests.sh",
            "cwd": "${workspaceFolder}/devtests/integration"
        },
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        }
    ]
}
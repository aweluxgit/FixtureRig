    "version": "0.2.0",
    "configurations": [
        {
            "name": "FixtureRig: demo test_02",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/fixturerig/main.py",
            "args": [
                "--config",
                "config/env.yaml",
                "--config",
                "config/test.yaml"
            ],
            "cwd": "${workspaceFolder}/demo/test_02",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            },
            "console": "integratedTerminal"
        },
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        }
    ]
}